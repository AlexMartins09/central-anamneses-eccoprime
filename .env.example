# ============================================================
# Central de Agendamento de Anamneses – Eccoprime
# Copie para .env (local) ou cadastre no painel do Render. NUNCA versione valores reais.
# ============================================================

# --- Banco de dados (Render PostgreSQL: use a "Internal Database URL") ---
# Dica: acrescente &connection_limit=10 para controlar o pool de conexões.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public"

# --- Aplicação ---
# URL pública (sem barra final). Usada em links de e-mail e no callback do Google.
APP_URL="https://agendamento.seudominio.com.br"

# --- Segredos (gere com: npm run gen:secrets) ---
AUTH_SECRET=""        # assina a sessão (mín. 32 caracteres)
ENCRYPTION_KEY=""     # mín. 32 caracteres – criptografa os tokens do Google
CRON_SECRET=""        # protege /api/cron/process

# --- Primeiro administrador (usado só pelo seed) ---
SEED_ADMIN_EMAIL="admin@eccoprime.com.br"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD=""   # se vazio, uma senha aleatória é gerada e impressa uma vez

# --- Google Calendar (OAuth 2.0) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Padrão: ${APP_URL}/api/google/callback  (cadastre exatamente este valor no Google Cloud)
GOOGLE_REDIRECT_URI=""

# --- E-mail (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"      # true para porta 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Eccoprime <nao-responder@eccoprime.com.br>"
